# Адрес WordPress, к которому ходит BFF (server/utils/wpFetch.ts). Отсюда же приходят товары и картинки.
# Локально: http://branded.loc, на VPS: внутренний адрес http://127.0.0.1:8081
# Если указан прод (https://branded.com.ua): заказы, отзывы и подписки из локального Nuxt — НАСТОЯЩИЕ
# (письма клиенту и админу, Telegram, списание остатков).
NUXT_WP_SITE_URL=https://branded.com.ua
# Таймаут запроса к WP, мс
NUXT_WP_TIMEOUT=8000

# Домен сайта: canonical, hreflang, og:url
NUXT_PUBLIC_SITE_URL=https://branded.com.ua

# Секреты (те же значения, что в wp-config.php)
# BRANDED_BFF_SECRET — WP доверяет IP покупателя из заголовка X-Branded-Client-IP (rate limit заказов)
NUXT_BFF_SECRET=
# BRANDED_REVALIDATE_SECRET — WP вызывает POST /api/_revalidate при изменениях
NUXT_REVALIDATE_SECRET=

# Кеш ответов API (и HTML, когда он включён) в Redis: общий для всех инстансов PM2, переживает деплой.
# На VPS: redis://127.0.0.1:6379/1 (db0 занимает WP). Пусто — кеш в памяти процесса, у каждого инстанса свой.
NUXT_REDIS_URL=

# Аналитика (только на проде, иначе тестовый трафик попадёт в отчёты)
# Живой сайт: GTM-PVBLHTV, пиксель 694506855746394
NUXT_PUBLIC_GTM_ID=
NUXT_PUBLIC_FB_PIXEL_ID=
